{
  "name": "skillhub-web",
  "private": true,
  "version": "0.1.0",
  "description": "SkillHub Web UI",
  "license": "MIT",
  "packageManager": "npm@10.9.7",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prebuild": "mkdir -p public/swagger && cp -f node_modules/swagger-ui-dist/swagger-ui.css node_modules/swagger-ui-dist/swagger-ui-bundle.js public/swagger/",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "test": "node --test --experimental-strip-types src/**/*.test.ts",
    "preview": "vite preview"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@saker/skillhub-client": "workspace:*",
    "@saker/skillhub-pages": "workspace:*",
    "@saker/web-shared": "workspace:*",
    "@types/dompurify": "^3.2.0",
    "dompurify": "^3.4.17",
    "i18next": "^26.5.11",
    "i18next-browser-languagedetector": "^8.2.3",
    "lucide-react": "^1.61.0",
    "marked": "^18.1.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^17.1.9",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "swagger-ui-dist": "^5.34.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5"
  }
}
